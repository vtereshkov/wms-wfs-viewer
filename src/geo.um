// Planar geometry primitives and the coordinate reference systems supported by the viewer

import "std.um"

type Point* = struct {
	x, y: real
}

fn (this: ^Point) dist*(p: Point): real {
	return sqrt((this.x - p.x) * (this.x - p.x) + (this.y - p.y) * (this.y - p.y))
}

// Distance from the point to the segment [a, b]
fn (this: ^Point) distToSegment*(a, b: Point): real {
	dx, dy := b.x - a.x, b.y - a.y
	lenSq := dx * dx + dy * dy
	if lenSq == 0 {
		return this.dist(a)
	}

	t := ((this.x - a.x) * dx + (this.y - a.y) * dy) / lenSq
	if t < 0 {t = 0}
	if t > 1 {t = 1}

	return this.dist({a.x + t * dx, a.y + t * dy})
}

type Box* = struct {
	min, max: Point
}

const huge* = 1e300

fn emptyBox*(): Box {
	return {{huge, huge}, {-huge, -huge}}
}

fn (this: ^Box) isEmpty*(): bool {
	return this.min.x > this.max.x || this.min.y > this.max.y
}

fn (this: ^Box) add*(p: Point) {
	if p.x < this.min.x {this.min.x = p.x}
	if p.y < this.min.y {this.min.y = p.y}
	if p.x > this.max.x {this.max.x = p.x}
	if p.y > this.max.y {this.max.y = p.y}
}

fn (this: ^Box) width*(): real {
	return this.max.x - this.min.x
}

fn (this: ^Box) height*(): real {
	return this.max.y - this.min.y
}

fn (this: ^Box) center*(): Point {
	return {(this.min.x + this.max.x) / 2, (this.min.y + this.max.y) / 2}
}

fn (this: ^Box) contains*(p: Point): bool {
	return p.x >= this.min.x && p.x <= this.max.x && p.y >= this.min.y && p.y <= this.max.y
}

fn (this: ^Box) containsBox*(b: Box): bool {
	return b.min.x >= this.min.x && b.max.x <= this.max.x && b.min.y >= this.min.y && b.max.y <= this.max.y
}

fn (this: ^Box) intersects*(b: Box): bool {
	return b.min.x <= this.max.x && b.max.x >= this.min.x && b.min.y <= this.max.y && b.max.y >= this.min.y
}

// Returns the box grown by `d` on every side
fn (this: ^Box) grown*(d: real): Box {
	return {{this.min.x - d, this.min.y - d}, {this.max.x + d, this.max.y + d}}
}

// Returns the box scaled by `factor` around its center
fn (this: ^Box) scaled*(factor: real): Box {
	c := this.center()
	hw, hh := this.width() * factor / 2, this.height() * factor / 2
	return {{c.x - hw, c.y - hh}, {c.x + hw, c.y + hh}}
}

// Coordinate reference systems. Geographic coordinates are always stored as {lon, lat}

const deg = std::pi / 180.0

// Ellipsoids, by the semi-major axis and the squared eccentricity

const (
	wgs84A = 6378137.0
	wgs84E2 = 1 / 298.257223563 * (2 - 1 / 298.257223563)

	airyA = 6377563.396                                 // Airy 1830, used by OSGB36
	airyE2 = 1 - 6356256.909 * 6356256.909 / (airyA * airyA)
)

// Transverse Mercator, after J. P. Snyder, Map Projections - A Working Manual, chapter 8.
// Accurate to about a millimeter within a few degrees of the central meridian

type TransverseMercator = struct {
	a, e2: real                         // Ellipsoid
	k0: real                            // Scale factor on the central meridian
	lat0, lon0: real                    // Origin, in radians
	falseEasting, falseNorthing: real
}

// Universal Transverse Mercator on WGS 84. ETRS89 differs from WGS 84 by less than a meter
fn utm(zone: int, south: bool): TransverseMercator {
	return {a: wgs84A, e2: wgs84E2, k0: 0.9996, lon0: (zone * 6 - 183) * deg,
		falseEasting: 500000, falseNorthing: south ? 10000000 : 0}
}

// British National Grid on OSGB36
fn britishNationalGrid(): TransverseMercator {
	return {a: airyA, e2: airyE2, k0: 0.9996012717, lat0: 49 * deg, lon0: -2 * deg,
		falseEasting: 400000, falseNorthing: -100000}
}

// Distance along the meridian from the equator to `lat` (in radians)
fn (this: ^TransverseMercator) meridianArc(lat: real): real {
	e2, e4, e6 := this.e2, this.e2 * this.e2, this.e2 * this.e2 * this.e2
	return this.a * ((1 - e2 / 4 - 3 * e4 / 64 - 5 * e6 / 256) * lat -
		(3 * e2 / 8 + 3 * e4 / 32 + 45 * e6 / 1024) * sin(2 * lat) +
		(15 * e4 / 256 + 45 * e6 / 1024) * sin(4 * lat) -
		35 * e6 / 3072 * sin(6 * lat))
}

// Projects {lon, lat} given on the ellipsoid of the projection
fn (this: ^TransverseMercator) project(p: Point): Point {
	ep2 := this.e2 / (1 - this.e2)       // Squared second eccentricity
	lat := p.y * deg
	s, c := sin(lat), cos(lat)

	n := this.a / sqrt(1 - this.e2 * s * s)
	t := s * s / (c * c)
	cc := ep2 * c * c
	a := c * (p.x * deg - this.lon0)
	a2 := a * a

	x := this.k0 * n * a * (1 + a2 / 6 * ((1 - t + cc) + a2 / 20 * (5 - 18 * t + t * t + 72 * cc - 58 * ep2)))
	y := this.k0 * (this.meridianArc(lat) - this.meridianArc(this.lat0) +
		n * s / c * a2 * (0.5 + a2 / 24 * ((5 - t + 9 * cc + 4 * cc * cc) + a2 / 30 * (61 - 58 * t + t * t + 600 * cc - 330 * ep2))))

	return {this.falseEasting + x, this.falseNorthing + y}
}

// Returns {lon, lat} on the ellipsoid of the projection
fn (this: ^TransverseMercator) unproject(p: Point): Point {
	e2, ep2 := this.e2, this.e2 / (1 - this.e2)
	x := p.x - this.falseEasting
	m := this.meridianArc(this.lat0) + (p.y - this.falseNorthing) / this.k0

	// Footpoint latitude
	e1 := (1 - sqrt(1 - e2)) / (1 + sqrt(1 - e2))
	mu := m / (this.a * (1 - e2 / 4 - 3 * e2 * e2 / 64 - 5 * e2 * e2 * e2 / 256))
	lat1 := mu + (3 * e1 / 2 - 27 * e1 * e1 * e1 / 32) * sin(2 * mu) + (21 * e1 * e1 / 16 - 55 * e1 * e1 * e1 * e1 / 32) * sin(4 * mu) +
		151 * e1 * e1 * e1 / 96 * sin(6 * mu) + 1097 * e1 * e1 * e1 * e1 / 512 * sin(8 * mu)

	s, c := sin(lat1), cos(lat1)
	t := s * s / (c * c)
	cc := ep2 * c * c
	w := 1 - e2 * s * s
	n := this.a / sqrt(w)
	r := this.a * (1 - e2) / (w * sqrt(w))
	d := x / (n * this.k0)
	d2 := d * d

	lat := lat1 - n * s / c / r * d2 * (0.5 - d2 / 24 * ((5 + 3 * t + 10 * cc - 4 * cc * cc - 9 * ep2) - d2 / 30 * (61 + 90 * t + 298 * cc + 45 * t * t - 252 * ep2 - 3 * cc * cc)))
	lon := this.lon0 + d * (1 - d2 / 6 * ((1 + 2 * t + cc) - d2 / 20 * (5 - 2 * cc + 28 * t - 3 * cc * cc + 8 * ep2 + 24 * t * t))) / c

	return {lon / deg, lat / deg}
}

// Datum shifts go through geocentric Cartesian coordinates. Heights are taken as zero

type Geocentric = struct {
	x, y, z: real
}

fn toGeocentric(p: Point, a, e2: real): Geocentric {
	lat, lon := p.y * deg, p.x * deg
	n := a / sqrt(1 - e2 * sin(lat) * sin(lat))
	return {n * cos(lat) * cos(lon), n * cos(lat) * sin(lon), n * (1 - e2) * sin(lat)}
}

fn fromGeocentric(g: Geocentric, a, e2: real): Point {
	p := sqrt(g.x * g.x + g.y * g.y)
	lat := atan2(g.z, p * (1 - e2))
	for i := 0; i < 4; i++ {            // Converges to well below a millimeter
		n := a / sqrt(1 - e2 * sin(lat) * sin(lat))
		lat = atan2(g.z + e2 * n * sin(lat), p)
	}
	return {atan2(g.y, g.x) / deg, lat / deg}
}

// The Helmert transformation from WGS 84 (or ETRS89) to OSGB36 given by Ordnance Survey in
// A Guide to Coordinate Systems in Great Britain, section 6.6. Accurate to about 5 m.
// With `sign` = -1, applies the inverse, approximated by negating the parameters, which costs a few centimeters
fn helmertToOsgb36(g: Geocentric, sign: real): Geocentric {
	const (
		tx = -446.448                   // Meters
		ty = 125.157
		tz = -542.060
		s = 20.4894e-6                  // Scale change
		rx = -0.1502 / 3600 * deg       // Rotations
		ry = -0.2470 / 3600 * deg
		rz = -0.8421 / 3600 * deg
	)

	k := 1 + sign * s
	return {
		sign * (tx - rz * g.y + ry * g.z) + k * g.x,
		sign * (ty + rz * g.x - rx * g.z) + k * g.y,
		sign * (tz - ry * g.x + rx * g.y) + k * g.z}
}

fn wgs84ToOsgb36(p: Point): Point {
	return fromGeocentric(helmertToOsgb36(toGeocentric(p, wgs84A, wgs84E2), 1), airyA, airyE2)
}

fn osgb36ToWgs84(p: Point): Point {
	return fromGeocentric(helmertToOsgb36(toGeocentric(p, airyA, airyE2), -1), wgs84A, wgs84E2)
}

type Crs* = struct {
	epsg: int
}

// National grids, preferred within their areas of use ({lon, lat})
type NationalGrid = struct {
	epsg: int
	area: Box
}

// In the order of preference for the data around `center` ({lon, lat}): a national grid, the local UTM zone, Web Mercator, WGS 84
fn candidateCrs*(center: Point): []Crs {
	grids := []NationalGrid{
		{2056, {{5.96, 45.82}, {10.49, 47.81}}},        // Swiss LV95
		{27700, {{-9.01, 49.75}, {2.01, 61.01}}}}       // British National Grid

	res := []Crs{}
	for _, grid^ in grids {
		if grid.area.contains(center) {
			res = append(res, Crs{grid.epsg})
		}
	}

	zone := floor((center.x + 180) / 6) + 1
	if zone < 1 {zone = 1}
	if zone > 60 {zone = 60}

	utmCrs := center.y >= 0 ? []Crs{{32600 + zone}, {25800 + zone}} : []Crs{{32700 + zone}}
	return append(append(res, utmCrs), []Crs{{3857}, {4326}})
}

// Extracts the EPSG code from "EPSG:2056", "urn:ogc:def:crs:EPSG::2056", "http://www.opengis.net/def/crs/EPSG/0/2056", etc.
fn epsgCode*(s: str): int {
	i := len(s)
	for i > 0 && s[i - 1] >= '0' && s[i - 1] <= '9' {
		i--
	}
	if i == len(s) {
		return 0
	}
	return std::atoi(slice(s, i))
}

fn (this: ^Crs) name*(): str {
	return sprintf("EPSG:%d", this.epsg)
}

fn (this: ^Crs) urn*(): str {
	return sprintf("urn:ogc:def:crs:EPSG::%d", this.epsg)
}

fn (this: ^Crs) isGeographic*(): bool {
	return this.epsg == 4326
}

// True if the CRS axis order is latitude first, as respected by WMS 1.3 and WFS 1.1+
fn (this: ^Crs) latFirst*(): bool {
	return this.isGeographic()
}

// All the projected CRSs supported are in meters
fn (this: ^Crs) metersPerUnit*(): real {
	return this.isGeographic() ? 111320.0 : 1.0
}

// Returns the zone and the hemisphere (true for south) of a UTM CRS, or zero zone for other CRSs
fn (this: ^Crs) utmZone*(): (int, bool) {
	if this.epsg > 32600 && this.epsg <= 32660 {return this.epsg - 32600, false}     // WGS 84, north
	if this.epsg > 32700 && this.epsg <= 32760 {return this.epsg - 32700, true}      // WGS 84, south
	if this.epsg >= 25828 && this.epsg <= 25838 {return this.epsg - 25800, false}    // ETRS89
	return 0, false
}

fn (this: ^Crs) toWgs84*(p: Point): Point {
	if zone, south := this.utmZone(); zone > 0 {
		tm := utm(zone, south)
		return tm.unproject(p)
	}

	switch this.epsg {
		case 2056:
			// Swisstopo approximate formulas, accurate to about 1 m
			y := (p.x - 2600000) / 1e6
			x := (p.y - 1200000) / 1e6
			lon := 2.6779094 + 4.728982 * y + 0.791484 * y * x + 0.1306 * y * x * x - 0.0436 * y * y * y
			lat := 16.9023892 + 3.238272 * x - 0.270978 * y * y - 0.002528 * x * x - 0.0447 * y * y * x - 0.0140 * x * x * x
			return {lon * 100 / 36, lat * 100 / 36}

		case 3857:
			const r = 6378137.0
			return {p.x / r / deg, (2 * atan(exp(p.y / r)) - std::pi / 2) / deg}

		case 27700:
			grid := britishNationalGrid()
			return osgb36ToWgs84(grid.unproject(p))
	}
	return p
}

fn (this: ^Crs) fromWgs84*(p: Point): Point {
	if zone, south := this.utmZone(); zone > 0 {
		tm := utm(zone, south)
		return tm.project(p)
	}

	switch this.epsg {
		case 2056:
			lat := (p.y * 3600 - 169028.66) / 10000
			lon := (p.x * 3600 - 26782.5) / 10000
			e := 2600072.37 + 211455.93 * lon - 10938.51 * lon * lat - 0.36 * lon * lat * lat - 44.54 * lon * lon * lon
			n := 1200147.07 + 308807.95 * lat + 3745.25 * lon * lon + 76.63 * lat * lat - 194.56 * lon * lon * lat + 119.79 * lat * lat * lat
			return {e, n}

		case 3857:
			const r = 6378137.0
			return {p.x * deg * r, r * log(sin(std::pi / 4 + p.y * deg / 2) / cos(std::pi / 4 + p.y * deg / 2))}

		case 27700:
			grid := britishNationalGrid()
			return grid.project(wgs84ToOsgb36(p))
	}
	return p
}

// Converts a {lon, lat} box to this CRS
fn (this: ^Crs) boxFromWgs84*(b: Box): Box {
	res := emptyBox()
	for _, corner in []Point{b.min, b.max, {b.min.x, b.max.y}, {b.max.x, b.min.y}} {
		res.add(this.fromWgs84(corner))
	}
	return res
}
