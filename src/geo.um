// Planar geometry primitives and the coordinate reference systems supported by the viewer

import "std.um"

type Point* = struct {
	x, y: real
}

fn (this: ^Point) dist*(p: Point): real {
	return sqrt((this.x - p.x) * (this.x - p.x) + (this.y - p.y) * (this.y - p.y))
}

// Distance from the point to the segment [a, b]
fn (this: ^Point) distToSegment*(a, b: Point): real {
	dx, dy := b.x - a.x, b.y - a.y
	lenSq := dx * dx + dy * dy
	if lenSq == 0 {
		return this.dist(a)
	}

	t := ((this.x - a.x) * dx + (this.y - a.y) * dy) / lenSq
	if t < 0 {t = 0}
	if t > 1 {t = 1}

	return this.dist({a.x + t * dx, a.y + t * dy})
}

type Box* = struct {
	min, max: Point
}

const huge* = 1e300

fn emptyBox*(): Box {
	return {{huge, huge}, {-huge, -huge}}
}

fn (this: ^Box) isEmpty*(): bool {
	return this.min.x > this.max.x || this.min.y > this.max.y
}

fn (this: ^Box) add*(p: Point) {
	if p.x < this.min.x {this.min.x = p.x}
	if p.y < this.min.y {this.min.y = p.y}
	if p.x > this.max.x {this.max.x = p.x}
	if p.y > this.max.y {this.max.y = p.y}
}

fn (this: ^Box) width*(): real {
	return this.max.x - this.min.x
}

fn (this: ^Box) height*(): real {
	return this.max.y - this.min.y
}

fn (this: ^Box) center*(): Point {
	return {(this.min.x + this.max.x) / 2, (this.min.y + this.max.y) / 2}
}

fn (this: ^Box) contains*(p: Point): bool {
	return p.x >= this.min.x && p.x <= this.max.x && p.y >= this.min.y && p.y <= this.max.y
}

fn (this: ^Box) containsBox*(b: Box): bool {
	return b.min.x >= this.min.x && b.max.x <= this.max.x && b.min.y >= this.min.y && b.max.y <= this.max.y
}

fn (this: ^Box) intersects*(b: Box): bool {
	return b.min.x <= this.max.x && b.max.x >= this.min.x && b.min.y <= this.max.y && b.max.y >= this.min.y
}

// Returns the box grown by `d` on every side
fn (this: ^Box) grown*(d: real): Box {
	return {{this.min.x - d, this.min.y - d}, {this.max.x + d, this.max.y + d}}
}

// Returns the box scaled by `factor` around its center
fn (this: ^Box) scaled*(factor: real): Box {
	c := this.center()
	hw, hh := this.width() * factor / 2, this.height() * factor / 2
	return {{c.x - hw, c.y - hh}, {c.x + hw, c.y + hh}}
}

// Coordinate reference systems. Geographic coordinates are always stored as {lon, lat}

const deg = std::pi / 180.0

// Universal Transverse Mercator on the WGS 84 ellipsoid, after J. P. Snyder, Map Projections - A Working Manual,
// chapter 8. Accurate to about a millimeter within a zone. ETRS89 differs from WGS 84 by less than a meter

const (
	utmA = 6378137.0                                    // Semi-major axis
	utmF = 1 / 298.257223563                            // Flattening
	utmE2 = utmF * (2 - utmF)                           // Squared eccentricity
	utmEp2 = utmE2 / (1 - utmE2)                        // Squared second eccentricity
	utmK0 = 0.9996                                      // Scale factor on the central meridian
	utmFalseEasting = 500000.0
	utmFalseNorthing = 10000000.0                       // In the southern hemisphere
)

fn centralMeridian(zone: int): real {
	return (zone * 6 - 183) * deg
}

// Distance along the meridian from the equator to `lat` (in radians)
fn meridianArc(lat: real): real {
	const (
		e2 = utmE2
		e4 = utmE2 * utmE2
		e6 = utmE2 * utmE2 * utmE2
	)
	return utmA * ((1 - e2 / 4 - 3 * e4 / 64 - 5 * e6 / 256) * lat -
		(3 * e2 / 8 + 3 * e4 / 32 + 45 * e6 / 1024) * sin(2 * lat) +
		(15 * e4 / 256 + 45 * e6 / 1024) * sin(4 * lat) -
		35 * e6 / 3072 * sin(6 * lat))
}

fn utmFromWgs84(p: Point, zone: int, south: bool): Point {
	lat := p.y * deg
	s, c := sin(lat), cos(lat)

	n := utmA / sqrt(1 - utmE2 * s * s)
	t := s * s / (c * c)
	cc := utmEp2 * c * c
	a := c * (p.x * deg - centralMeridian(zone))
	a2 := a * a

	x := utmK0 * n * a * (1 + a2 / 6 * ((1 - t + cc) + a2 / 20 * (5 - 18 * t + t * t + 72 * cc - 58 * utmEp2)))
	y := utmK0 * (meridianArc(lat) + n * s / c * a2 * (0.5 + a2 / 24 * ((5 - t + 9 * cc + 4 * cc * cc) + a2 / 30 * (61 - 58 * t + t * t + 600 * cc - 330 * utmEp2))))

	return {utmFalseEasting + x, south ? utmFalseNorthing + y : y}
}

fn utmToWgs84(p: Point, zone: int, south: bool): Point {
	x := p.x - utmFalseEasting
	y := south ? p.y - utmFalseNorthing : p.y

	// Footpoint latitude
	e1 := (1 - sqrt(1 - utmE2)) / (1 + sqrt(1 - utmE2))
	mu := y / utmK0 / (utmA * (1 - utmE2 / 4 - 3 * utmE2 * utmE2 / 64 - 5 * utmE2 * utmE2 * utmE2 / 256))
	lat1 := mu + (3 * e1 / 2 - 27 * e1 * e1 * e1 / 32) * sin(2 * mu) + (21 * e1 * e1 / 16 - 55 * e1 * e1 * e1 * e1 / 32) * sin(4 * mu) +
		151 * e1 * e1 * e1 / 96 * sin(6 * mu) + 1097 * e1 * e1 * e1 * e1 / 512 * sin(8 * mu)

	s, c := sin(lat1), cos(lat1)
	t := s * s / (c * c)
	cc := utmEp2 * c * c
	w := 1 - utmE2 * s * s
	n := utmA / sqrt(w)
	r := utmA * (1 - utmE2) / (w * sqrt(w))
	d := x / (n * utmK0)
	d2 := d * d

	lat := lat1 - n * s / c / r * d2 * (0.5 - d2 / 24 * ((5 + 3 * t + 10 * cc - 4 * cc * cc - 9 * utmEp2) - d2 / 30 * (61 + 90 * t + 298 * cc + 45 * t * t - 252 * utmEp2 - 3 * cc * cc)))
	lon := centralMeridian(zone) + d * (1 - d2 / 6 * ((1 + 2 * t + cc) - d2 / 20 * (5 - 2 * cc + 28 * t - 3 * cc * cc + 8 * utmEp2 + 24 * t * t))) / c

	return {lon / deg, lat / deg}
}

type Crs* = struct {
	epsg: int
}

// In the order of preference for the data around `center` ({lon, lat}): Swiss LV95, the local UTM zone, Web Mercator, WGS 84
fn candidateCrs*(center: Point): []Crs {
	zone := floor((center.x + 180) / 6) + 1
	if zone < 1 {zone = 1}
	if zone > 60 {zone = 60}

	utm := center.y >= 0 ? []Crs{{32600 + zone}, {25800 + zone}} : []Crs{{32700 + zone}}
	return append(append([]Crs{{2056}}, utm), []Crs{{3857}, {4326}})
}

// Extracts the EPSG code from "EPSG:2056", "urn:ogc:def:crs:EPSG::2056", "http://www.opengis.net/def/crs/EPSG/0/2056", etc.
fn epsgCode*(s: str): int {
	i := len(s)
	for i > 0 && s[i - 1] >= '0' && s[i - 1] <= '9' {
		i--
	}
	if i == len(s) {
		return 0
	}
	return std::atoi(slice(s, i))
}

fn (this: ^Crs) name*(): str {
	return sprintf("EPSG:%d", this.epsg)
}

fn (this: ^Crs) urn*(): str {
	return sprintf("urn:ogc:def:crs:EPSG::%d", this.epsg)
}

fn (this: ^Crs) isGeographic*(): bool {
	return this.epsg == 4326
}

// True if the CRS axis order is latitude first, as respected by WMS 1.3 and WFS 1.1+
fn (this: ^Crs) latFirst*(): bool {
	return this.isGeographic()
}

fn (this: ^Crs) metersPerUnit*(): real {
	return this.isGeographic() ? 111320.0 : 1.0
}

// Returns the zone and the hemisphere (true for south) of a UTM CRS, or zero zone for other CRSs
fn (this: ^Crs) utmZone*(): (int, bool) {
	if this.epsg > 32600 && this.epsg <= 32660 {return this.epsg - 32600, false}     // WGS 84, north
	if this.epsg > 32700 && this.epsg <= 32760 {return this.epsg - 32700, true}      // WGS 84, south
	if this.epsg >= 25828 && this.epsg <= 25838 {return this.epsg - 25800, false}    // ETRS89
	return 0, false
}

fn (this: ^Crs) toWgs84*(p: Point): Point {
	if zone, south := this.utmZone(); zone > 0 {
		return utmToWgs84(p, zone, south)
	}

	switch this.epsg {
		case 2056:
			// Swisstopo approximate formulas, accurate to about 1 m
			y := (p.x - 2600000) / 1e6
			x := (p.y - 1200000) / 1e6
			lon := 2.6779094 + 4.728982 * y + 0.791484 * y * x + 0.1306 * y * x * x - 0.0436 * y * y * y
			lat := 16.9023892 + 3.238272 * x - 0.270978 * y * y - 0.002528 * x * x - 0.0447 * y * y * x - 0.0140 * x * x * x
			return {lon * 100 / 36, lat * 100 / 36}

		case 3857:
			const r = 6378137.0
			return {p.x / r / deg, (2 * atan(exp(p.y / r)) - std::pi / 2) / deg}
	}
	return p
}

fn (this: ^Crs) fromWgs84*(p: Point): Point {
	if zone, south := this.utmZone(); zone > 0 {
		return utmFromWgs84(p, zone, south)
	}

	switch this.epsg {
		case 2056:
			lat := (p.y * 3600 - 169028.66) / 10000
			lon := (p.x * 3600 - 26782.5) / 10000
			e := 2600072.37 + 211455.93 * lon - 10938.51 * lon * lat - 0.36 * lon * lat * lat - 44.54 * lon * lon * lon
			n := 1200147.07 + 308807.95 * lat + 3745.25 * lon * lon + 76.63 * lat * lat - 194.56 * lon * lon * lat + 119.79 * lat * lat * lat
			return {e, n}

		case 3857:
			const r = 6378137.0
			return {p.x * deg * r, r * log(sin(std::pi / 4 + p.y * deg / 2) / cos(std::pi / 4 + p.y * deg / 2))}
	}
	return p
}

// Converts a {lon, lat} box to this CRS
fn (this: ^Crs) boxFromWgs84*(b: Box): Box {
	res := emptyBox()
	for _, corner in []Point{b.min, b.max, {b.min.x, b.max.y}, {b.max.x, b.min.y}} {
		res.add(this.fromWgs84(corner))
	}
	return res
}
